# Source build for local use. CI does not use this file.
# Build from the repository root:
#   podman build -f Dockerfile.source -t backend .
# Runtime has no shell or package manager; for debugging use
# gcr.io/distroless/java25-debian13:debug.

# ---- frontend stage ----
FROM docker.io/oven/bun:1.4 AS frontend
WORKDIR /src
ARG GIT_COMMIT

COPY package.json bun.lock ./
COPY frontend/package.json frontend/package.json
# Skip prepare (lefthook) — git hooks are irrelevant inside the image
RUN bun install --frozen-lockfile --ignore-scripts

COPY frontend/ frontend/
ENV GIT_COMMIT=${GIT_COMMIT}
RUN bun run --cwd frontend build

# ---- backend builder ----
FROM docker.io/eclipse-temurin:25-jdk AS builder
WORKDIR /build
ARG GIT_COMMIT

COPY backend/gradle/ gradle/
COPY backend/gradlew gradlew
COPY backend/build.gradle.kts build.gradle.kts
COPY backend/settings.gradle.kts settings.gradle.kts
COPY backend/gradle.properties gradle.properties
COPY backend/src/ src/
COPY backend/scripts/ scripts/
ENV GIT_COMMIT=${GIT_COMMIT}
RUN --mount=type=cache,id=application-gradle,target=/root/.gradle \
    ./gradlew prepareDockerImageContext --no-daemon

# ---- runtime ----
FROM gcr.io/distroless/java25-debian13:nonroot
WORKDIR /app

COPY --from=builder --chown=65532:65532 /build/build/docker-image/lib /app/lib
COPY --from=frontend --chown=65532:65532 /src/frontend/dist /app/static
COPY --from=builder --chown=65532:65532 /build/build/docker-image/app.jar /app/app.jar

EXPOSE 8080

# Presence of /app/static/index.html disables Scalar and serves the SPA at /.
ENTRYPOINT ["java", \
    "--enable-native-access=ALL-UNNAMED", \
    "-cp", "/app/lib/*:/app/app.jar", \
    "net.axcira.MainKt"]
