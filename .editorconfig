root = true

[*.{tsx,ts}]
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ktlint_standard_no-unused-imports = enabled

# Allow `import foo.*` (and prefer it in the IDE when many names are used).
ktlint_standard_no-wildcard-imports = disabled
ij_kotlin_name_count_to_use_star_import = 5
ij_kotlin_name_count_to_use_star_import_for_members = 5

# Official style wrapping / signature rules are too aggressive for this codebase.
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_no-consecutive-comments = disabled
# OpenAPI route docs use KDoc inside routing lambdas; filename rule fights intentional names.
ktlint_standard_kdoc = disabled
ktlint_standard_filename = disabled
