{
  "name": "frontend",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check && bun run theme:check && bun run radius:check && bun run select:check && bun run button-link:check",
    "theme": "bun run scripts/theme.ts",
    "theme:check": "bun run scripts/theme.ts --check",
    "radius:check": "bun run scripts/radius-check.ts",
    "select:check": "bun run scripts/select-check.ts",
    "button-link:check": "bun run scripts/button-link-check.ts",
    "typecheck": "tsc --noEmit",
    "orval:gen": "orval",
    "orval:drift": "orval && git diff --exit-code -- src/api/generated/ && untracked=$(git ls-files --others --exclude-standard -- src/api/generated/) && test -z \"$untracked\"",
    "orval:watch": "orval --watch",
    "cf:dev": "wrangler dev",
    "cf:deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-plugin": "^1.168.48",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jotai": "^3.0.1",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@faker-js/faker": "^10.6.0",
    "@material/material-color-utilities": "^0.4.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "orval": "8.45.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.156.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
