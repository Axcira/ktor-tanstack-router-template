{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ktor-tanstack-router-template",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
