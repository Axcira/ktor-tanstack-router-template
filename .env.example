# Copy to `.env` and adjust as needed.
# The app reads these via the process environment (Docker/K8s/systemd/shell).
# `.env` itself is not loaded automatically by Ktor — export vars or use your runtime's env injection.

# --- PostgreSQL (HikariCP / Flyway) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=password

# --- Bootstrap admin (ApplicationInitializer on ApplicationStarted) ---
ADMIN_EMAIL=admin@example.com
ADMIN_ROLE_NAME=Administrator
# Required in production. In development (`io.ktor.development=true`) defaults to "password".
ADMIN_PASSWORD=password

# --- Password hashing (Argon2id + pepper) ---
# Pepper mixed into passwords before hash/verify. Change in production.
SECRET=secret
ARGON2_ITERATIONS=16
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=1

# --- Frontend SPA serving (production / container) ---
# Override SPA root (must contain index.html). Default probe order: STATIC_DIR → /app/static → ./static
# STATIC_DIR=/app/static
# Force SPA mode even when probing would skip it (still needs index.html under a probed path)
# SERVE_FRONTEND=true
# When SPA is served, Scalar at / is disabled. Set true to keep /openapi.json available.
# EXPOSE_OPENAPI=true

# --- Tooling / tests (normally unset in production) ---
# Skip Flyway migrate + allow Hikari to start without a live DB (OpenAPI codegen, some tests)
# SKIP_DATABASE=true
# Skip seeding admin role/user on startup (tests / OpenAPI codegen)
# SKIP_BOOTSTRAP=true
